# Production-конфигурация. Скопируйте в .env и замените все значения.
# Docker Compose читает файл .env автоматически.

# Домен, на который Caddy выпустит TLS-сертификат Let's Encrypt.
DOMAIN=it-admin.example.com
# Email для уведомлений Let's Encrypt об истечении сертификата.
ACME_EMAIL=admin@example.com
# Публичный адрес приложения — источник, которому разрешены запросы к API.
APP_ORIGIN=https://it-admin.example.com

# PostgreSQL. Пароль должен быть URL-безопасным: только буквы, цифры и - _ .
POSTGRES_DB=itadmin
POSTGRES_USER=itadmin
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Строка подключения для бэкенда. Должна совпадать с параметрами выше.
DATABASE_URL=postgres://itadmin:change-me-to-a-long-random-password@postgres:5432/itadmin

# JWT: минимум 32 символа. Сгенерируйте: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-value
JWT_EXPIRATION=86400

# Первый администратор создаётся только если таблица users пуста.
# Пароль должен быть не короче 12 символов и содержать букву и цифру.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-strong-password-1

APP_LOG_LEVEL=info
