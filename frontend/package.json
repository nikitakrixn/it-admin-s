{
  "name": "frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "frontend": "nuxt dev",
    "dev": "concurrently --prefix-colors cyan,magenta --kill-others -n backend,frontend \"cargo --color=always watch -C ../backend -x \\\"run --bin it-admin-backend\\\"\" \"npm run frontend\"",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/icon": "^2.0.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@vueuse/nuxt": "^15.0.0",
    "concurrently": "^10.0.7",
    "nuxt": "^4.1.3",
    "vue": "^3.5.22",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@iconify-json/ri": "^1.2.6",
    "@nuxt/eslint": "^1.17.0",
    "@nuxtjs/color-mode": "^4.1.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.1.1"
  }
}
