# Application
APP_NAME=IT-Admin
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=debug

# Database
DATABASE_URL=postgres://admin:secure_password@localhost:5432/itadmin
DATABASE_MAX_CONNECTIONS=10

# JWT Authentication
# В production задайте случайное значение не короче 32 символов:
#   openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=86400

# CORS: источники, которым разрешены запросы к API.
# При работе через Nuxt-BFF браузер обращается к тому же домену, поэтому
# достаточно адреса приложения.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Первый администратор. Используется только если в таблице users ещё нет записей.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe12345!

# Swagger UI и OpenAPI-спецификация. По умолчанию включены везде, кроме production.
DOCS_ENABLED=true

# Active Directory (LDAP)
AD_ENABLED=false
AD_SERVER=ldap://dc.example.com:389
AD_DOMAIN=example.com
AD_BASE_DN=DC=example,DC=com
AD_BIND_DN=CN=Admin,CN=Users,DC=example,DC=com
AD_BIND_PASSWORD=your-ad-password
AD_USE_TLS=true

# MikroTik
MIKROTIK_ENABLED=false
MIKROTIK_HOST=192.168.1.1
MIKROTIK_PORT=8728
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=mikrotik-password
